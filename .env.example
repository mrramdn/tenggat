# Salin file ini menjadi .env:  cp .env.example .env
# File .env tidak di-commit. Ganti kata sandi bila stack dipakai di luar komputer Anda sendiri.

# Port di komputer Anda untuk membuka Tenggat: http://localhost:8080
WEB_PORT=8080

# PostgreSQL
POSTGRES_DB=tenggat
POSTGRES_USER=tenggat
POSTGRES_PASSWORD=ganti-kata-sandi-ini

# Seberapa sering API memeriksa ulang sertifikat dan domain (format durasi Go: 30m, 6h, 24h)
CEK_INTERVAL=6h

# Batas permintaan tulis dan cek per pengunjung per menit (dijaga oleh Redis)
BATAS_PER_MENIT=30

# Adminer (profile tools): http://127.0.0.1:8081
ADMINER_PORT=8081
